# Copy to .env (git-ignored) and fill in. Used by `docker compose up` and by `npm start`.
# Empty values switch that sign-in provider off.

# --- Google (console.cloud.google.com > APIs & Services > Credentials) ---
# Public client IDs. The web one is also used by Expo on web.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Backend: every client ID above whose ID tokens it should accept, comma separated
PVM_GOOGLE_CLIENT_IDS=

# --- Facebook (developers.facebook.com > your app > Settings > Basic) ---
EXPO_PUBLIC_FACEBOOK_APP_ID=
# Backend: same App ID plus the App Secret (secret: never put it in an EXPO_PUBLIC_ variable)
PVM_FACEBOOK_APP_ID=
PVM_FACEBOOK_APP_SECRET=

# --- API tokens ---
# Signing key for the backend's own access tokens (32+ random characters in any shared environment)
PVM_JWT_SECRET=dev-only-jwt-secret-change-me-0123456789

# --- Push notifications (daily shift report to owners' phones) ---
# EAS project id (expo.dev > your project). Phones need it to get an Expo push token.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Backend: only if "Enhanced push security" is on in the Expo project (expo.dev > Access tokens)
PVM_EXPO_ACCESS_TOKEN=
